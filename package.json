{
  "name": "intern-ddexp-backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "app"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "db": "^6.0.3",
    "drizzle-orm": "^1.0.0-rc.4",
    "elysia": "^1.4.30",
    "pg": "^8.23.1",
    "postgres": "^3.4.9"
  },
  "scripts": {
    "generate": "bunx --bun drizzle-kit generate --config=packages/db/drizzle.config.ts --name ${name}",
    "dev": "bun --env-file .env --filter app --elide-lines=0 dev",
    "db:studio": "bun --env-file .env drizzle-kit studio --config=packages/db/drizzle.config.ts"
  }
}